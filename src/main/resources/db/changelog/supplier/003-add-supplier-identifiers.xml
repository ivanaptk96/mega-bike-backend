<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-add-supplier-identifiers" author="codex">
        <addColumn tableName="supplier">
            <column name="registration_number" type="varchar(40)"/>
            <column name="vat_registration_number" type="varchar(40)"/>
        </addColumn>

        <addUniqueConstraint tableName="supplier"
                             columnNames="registration_number"
                             constraintName="uk_supplier_registration_number"/>
        <addUniqueConstraint tableName="supplier"
                             columnNames="vat_registration_number"
                             constraintName="uk_supplier_vat_registration_number"/>
    </changeSet>
</databaseChangeLog>
